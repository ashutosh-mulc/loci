  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">LociRecallUI – Recall button, question panel and debrief</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"Recall button"}'
    - '// @input float recallButtonWidthCm = 12 {"hint":"Recall button width (cm). The brief asks for one large 12 cm button.", "widget":"slider", "min":6, "max":20, "step":0.5}'
    - '// @input float recallButtonHeightCm = 5 {"hint":"Recall button height (cm).", "widget":"slider", "min":4, "max":10, "step":0.5}'
    - '// @input float followAheadCm = 50 {"hint":"How far ahead of the user the button rests (cm).", "widget":"slider", "min":30, "max":100, "step":1}'
    - '// @input float followBelowEyeCm = 35 {"hint":"How far below eye level the button rests (cm).", "widget":"slider", "min":0, "max":60, "step":1}'
    - '// @input float followSpeed = 2 {"hint":"Lazy-follow speed: higher catches up faster.", "widget":"slider", "min":0.5, "max":8, "step":0.1}'
    - '// @input string recallLabel = "Recall" {"hint":"Label while in Explore."}'
    - '// @input string exploreLabel = "Explore" {"hint":"Label while in Recall."}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"Panel"}'
    - '// @input float panelWidthCm = 30 {"hint":"Panel width (cm).", "widget":"slider", "min":20, "max":45, "step":0.5}'
    - '// @input float actionButtonWidthCm = 8.5 {"hint":"Reveal / Right / Wrong button width (cm). At least 6 cm.", "widget":"slider", "min":6, "max":12, "step":0.5}'
    - '// @input float actionButtonHeightCm = 4.5 {"hint":"Reveal / Right / Wrong button height (cm).", "widget":"slider", "min":4, "max":8, "step":0.5}'
    - '// @input float readingDistanceCm = 110 {"hint":"Panel is authored for this distance (cm); farther spots scale it up so it reads the same size everywhere.", "widget":"slider", "min":80, "max":200, "step":5}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"Colours"}'
    - '// @input vec4 glowColor = "{0.62, 0.86, 1.0, 0.95}" {"hint":"Button outline glow.", "widget":"color"}'
    - '// @input vec4 glowHoverColor = "{1.0, 1.0, 1.0, 1.0}" {"hint":"Button outline glow when aimed at.", "widget":"color"}'
